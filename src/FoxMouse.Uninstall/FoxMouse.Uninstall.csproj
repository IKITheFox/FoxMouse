<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>FoxMouse.Uninstall</RootNamespace>
    <AssemblyName>FoxMouse.Uninstall</AssemblyName>
    <Product>FoxMouse Maintenance</Product>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\..\assets\branding\generated\FoxMouse.ico')">..\..\assets\branding\generated\FoxMouse.ico</ApplicationIcon>
    <ApplicationIcon Condition="!Exists('..\..\assets\branding\generated\FoxMouse.ico')">..\FoxMouse.App\Assets\FoxMouse.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FoxMouse.Deployment\FoxMouse.Deployment.csproj" />
  </ItemGroup>
</Project>
