<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FoxMouse.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="900"
            Padding="32,24,32,40"
            HorizontalAlignment="Stretch">
            <StackPanel Spacing="12">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Uid="GeneralPageString1" Style="{StaticResource TitleTextBlockStyle}" Text="常规" />
                </StackPanel>

                <Border Style="{StaticResource FoxMouseCardStyle}">
                    <Grid x:Uid="GeneralPageString2" ColumnSpacing="16" ToolTipService.ToolTip="保存后重新打开设置以应用语言。">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralPageString3" VerticalAlignment="Center" Text="界面语言" />
                        <ComboBox x:Uid="GeneralPageString4" Grid.Column="1" MinWidth="180" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" AutomationProperties.Name="界面语言">
                            <ComboBoxItem x:Uid="GeneralPageString5" Content="跟随系统" />
                            <ComboBoxItem x:Uid="GeneralPageString6" Content="简体中文" />
                            <ComboBoxItem Content="English" />
                        </ComboBox>
                    </Grid>
                </Border>
                <TextBlock x:Uid="GeneralPageString7" Style="{StaticResource FoxMouseSectionTitleStyle}" Text="光标效果" />

                <Border Style="{StaticResource FoxMouseCardStyle}">
                    <Grid x:Uid="GeneralPageString8"
                        ColumnSpacing="20"
                        ToolTipService.ToolTip="快速左右摇动鼠标时，平滑放大当前指针。">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralPageString9"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="启用 FoxMouse" />
                        <ToggleSwitch x:Uid="GeneralPageString10"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="快速左右摇动鼠标时，平滑放大当前指针。"
                            AutomationProperties.Name="启用 FoxMouse"
                            IsOn="{Binding Enabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource FoxMouseCardStyle}">
                    <Grid x:Uid="GeneralPageString11"
                        ColumnSpacing="24"
                        ToolTipService.ToolTip="原生模式放大当前光标；定位环模式显示光标位置提示。">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralPageString12"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="显示模式" />
                        <ComboBox x:Uid="GeneralPageString13"
                            Grid.Column="1"
                            MinWidth="132"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="原生模式放大当前光标；定位环模式显示光标位置提示。"
                            AutomationProperties.Name="显示模式"
                            SelectedIndex="{Binding ModeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="GeneralPageString14" Content="原生" />
                            <ComboBoxItem x:Uid="GeneralPageString15" Content="定位环" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource FoxMouseCardStyle}">
                    <Grid x:Uid="GeneralPageString16"
                        RowSpacing="8"
                        ToolTipService.ToolTip="数值越高，越容易通过快速来回移动触发效果。">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="GeneralPageString17"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="摇动灵敏度" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{Binding SensitivityLabel, Mode=OneWay}" />
                        </Grid>
                        <Slider x:Uid="GeneralPageString18"
                            Grid.Row="1"
                            Margin="28,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="数值越高，越容易通过快速来回移动触发效果。"
                            AutomationProperties.Name="摇动灵敏度"
                            LargeChange="0.1"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.05"
                            StepFrequency="0.05"
                            Value="{Binding Sensitivity, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource FoxMouseCardStyle}">
                    <Grid x:Uid="GeneralPageString19"
                        ColumnSpacing="24"
                        ToolTipService.ToolTip="可设置为原始光标的 1.5 到 6 倍。">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralPageString20"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="最大放大倍率" />
                        <NumberBox x:Uid="GeneralPageString21"
                            x:Name="MaxScaleNumberBox"
                            Grid.Column="1"
                            Width="180"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="可设置为原始光标的 1.5 到 6 倍。"
                            AutomationProperties.Name="最大放大倍率"
                            LargeChange="0.5"
                            Maximum="6"
                            Minimum="1.5"
                            SmallChange="0.1"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding MaxScale, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource FoxMouseCardStyle}">
                    <Grid x:Uid="GeneralPageString22"
                        ColumnSpacing="20"
                        ToolTipService.ToolTip="立即在当前鼠标位置演示一次放大效果。">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="GeneralPageString23"
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="预览效果" />
                        <Button x:Uid="GeneralPageString24"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="立即在当前鼠标位置演示一次放大效果。"
                            AutomationProperties.Name="预览放大效果"
                            Click="Preview_Click"
                            Content="预览放大效果" />
                    </Grid>
                </Border>

                <TextBlock x:Uid="GeneralPageString25" Style="{StaticResource FoxMouseSectionTitleStyle}" Text="行为" />

                <Border Style="{StaticResource FoxMouseCardStyle}">
                    <StackPanel Spacing="18">
                        <Grid x:Uid="GeneralPageString26"
                            ColumnSpacing="20"
                            ToolTipService.ToolTip="登录 Windows 后在后台启动 FoxMouse。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="GeneralPageString27"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="随 Windows 启动" />
                            <ToggleSwitch x:Uid="GeneralPageString28"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.HelpText="登录 Windows 后在后台启动 FoxMouse。"
                                AutomationProperties.Name="随 Windows 启动"
                                IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid x:Uid="GeneralPageString29"
                            ColumnSpacing="20"
                            ToolTipService.ToolTip="拖动文件或控件时不触发放大效果。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="GeneralPageString30"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="拖拽时暂停" />
                            <ToggleSwitch x:Uid="GeneralPageString31"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.HelpText="拖动文件或控件时不触发放大效果。"
                                AutomationProperties.Name="拖拽时暂停"
                                IsOn="{Binding DisableWhileDragging, Mode=TwoWay}" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid x:Uid="GeneralPageString32"
                            ColumnSpacing="20"
                            ToolTipService.ToolTip="游戏、视频和演示进入全屏时自动暂停。">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="GeneralPageString33"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="全屏应用中暂停" />
                            <ToggleSwitch x:Uid="GeneralPageString34"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.HelpText="游戏、视频和演示进入全屏时自动暂停。"
                                AutomationProperties.Name="全屏应用中暂停"
                                IsOn="{Binding PauseInFullscreen, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
