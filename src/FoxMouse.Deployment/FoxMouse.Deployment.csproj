<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="..\..\installer\ThemeAwareComboBox.cs" Link="ThemeAwareComboBox.cs" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>FoxMouse.Deployment</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <PublishTrimmed>false</PublishTrimmed>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FoxMouse.Core\FoxMouse.Core.csproj" />
    <EmbeddedResource Include="..\..\assets\branding\generated\FoxMouse.ico" LogicalName="FoxMouse.Deployment.Branding.FoxMouse.ico" />
    <EmbeddedResource Include="..\..\assets\branding\generated\FoxMouse.Dark.ico" LogicalName="FoxMouse.Deployment.Branding.FoxMouse.Dark.ico" />
    <EmbeddedResource Include="..\..\assets\branding\generated\FoxMouse.HighContrast.Black.ico" LogicalName="FoxMouse.Deployment.Branding.FoxMouse.HighContrast.Black.ico" />
    <EmbeddedResource Include="..\..\assets\branding\generated\FoxMouse.HighContrast.White.ico" LogicalName="FoxMouse.Deployment.Branding.FoxMouse.HighContrast.White.ico" />
    <EmbeddedResource Include="..\..\assets\branding\source\foxmouse-mark-color.png" LogicalName="FoxMouse.Deployment.Branding.FoxMouse.Mark.Light.png" />
    <EmbeddedResource Include="..\..\assets\branding\source\foxmouse-mark-dark.png" LogicalName="FoxMouse.Deployment.Branding.FoxMouse.Mark.Dark.png" />
    <EmbeddedResource Include="..\..\assets\branding\source\foxmouse-mark-mono-black.png" LogicalName="FoxMouse.Deployment.Branding.FoxMouse.Mark.HighContrast.Black.png" />
    <EmbeddedResource Include="..\..\assets\branding\source\foxmouse-mark-mono-white.png" LogicalName="FoxMouse.Deployment.Branding.FoxMouse.Mark.HighContrast.White.png" />
  </ItemGroup>
</Project>
